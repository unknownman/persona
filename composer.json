{
    "name": "laravel-persona/core",
    "version": "1.4.0",
    "description": "Persona - A headless data layer for person-related data using polymorphic relations.",
    "keywords": ["persona", "person", "profile", "contact", "address", "laravel", "headless"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Persona\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Persona\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Persona\\Providers\\PersonaServiceProvider"
            ],
            "aliases": {}
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}