{
    "name": "laravel-persona/monorepo",
    "description": "Persona monorepo - a development workspace for the headless Persona ecosystem (core, blade, livewire, inertia, api).",
    "keywords": ["persona", "laravel", "monorepo", "workspace"],
    "license": "MIT",
    "private": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "laravel-persona/api": "*",
        "laravel-persona/blade": "*",
        "laravel-persona/core": "*",
        "laravel-persona/inertia": "*",
        "laravel-persona/livewire": "*",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}