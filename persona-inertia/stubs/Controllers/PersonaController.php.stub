<?php

namespace {{ namespace }};

use App\Http\Controllers\Controller;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Validation\ValidationException;
use Inertia\Inertia;
use Inertia\Response;
use Persona\Api\Http\Resources\ContactResource;
use Persona\Api\Http\Resources\ProfileResource;
use Persona\Managers\PersonaManager;
use Persona\Models\Contact;
use Persona\Models\Profile;

class PersonaController extends Controller
{
    public function __construct(private readonly PersonaManager $personaManager) {}

    /**
     * Render the profile + contacts page. Wire your routes to this action
     * with whatever auth/middleware your host application requires.
     */
    public function index(Model $personable): Response
    {
        return Inertia::render('Persona/Index', [
            'profile' => ProfileResource::make(
                Profile::query()
                    ->where('personable_type', $personable->getMorphClass())
                    ->where('personable_id', $personable->getKey())
                    ->first()
            ),
            'contacts' => ContactResource::collection(
                Contact::query()
                    ->where('personable_type', $personable->getMorphClass())
                    ->where('personable_id', $personable->getKey())
                    ->orderByDesc('is_primary')
                    ->orderBy('created_at')
                    ->get()
            ),
        ]);
    }

    public function storeContact(Model $personable, Request $request): JsonResponse
    {
        $validated = $request->validate([
            'type' => ['required', 'string'],
            'value' => ['required', 'string', 'max:255'],
            'is_primary' => ['sometimes', 'boolean'],
            'is_emergency' => ['sometimes', 'boolean'],
        ]);

        $contact = $this->personaManager
            ->contacts()
            ->add(
                $personable,
                $validated['type'],
                $validated['value'],
                isPrimary: $validated['is_primary'] ?? false,
                isEmergency: $validated['is_emergency'] ?? false,
            );

        return ContactResource::make($contact)
            ->response()
            ->setStatusCode(201);
    }

    public function destroyContact(Model $personable, Contact $contact): JsonResponse
    {
        $this->assertOwnedBy($personable, $contact);

        $contact->delete();

        return response()->json(['deleted' => true]);
    }

    public function setPrimaryContact(Model $personable, Contact $contact): JsonResponse
    {
        $this->assertOwnedBy($personable, $contact);

        Contact::query()
            ->where('personable_type', $personable->getMorphClass())
            ->where('personable_id', $personable->getKey())
            ->where('type', $contact->type)
            ->where('is_primary', true)
            ->update(['is_primary' => false]);

        $contact->update(['is_primary' => true]);

        return ContactResource::make($contact->fresh());
    }

    /**
     * Bind a route-model to personable, e.g. for a contact endpoint:
     *
     *     Route::post('/users/{user}/contacts', [PersonaController::class, 'storeContact'])
     *
     * so $personable is resolved as the current user automatically.
     */
    protected function assertOwnedBy(Model $personable, Contact $contact): void
    {
        throw_if(
            $contact->personable_type !== $personable->getMorphClass()
            || $contact->personable_id != $personable->getKey(),
            ValidationException::withMessages([
                'contact' => 'The contact does not belong to the given personable.',
            ])
        );
    }
}