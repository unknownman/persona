{
    "name": "laravel-persona/api",
    "version": "1.0.0",
    "description": "Persona API - secure JSON resource layer and controller stubs for exposing the headless Persona core over HTTP.",
    "keywords": ["persona", "laravel", "api", "json-resource", "profile", "contact"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel-persona/core": "^1.4",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Persona\\Api\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Persona\\Api\\Providers\\PersonaApiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}