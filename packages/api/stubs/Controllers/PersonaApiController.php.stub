<?php

namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;
use Illuminate\Validation\ValidationException;
use Persona\Api\Http\Resources\AddressResource;
use Persona\Api\Http\Resources\ContactResource;
use Persona\Api\Http\Resources\DocumentResource;
use Persona\Api\Http\Resources\LegalDetailResource;
use Persona\Api\Http\Resources\PhysicalAttributeResource;
use Persona\Api\Http\Resources\ProfileResource;
use Persona\Api\Http\Resources\RelationshipResource;
use Persona\Api\Http\Resources\SocialAccountResource;
use Persona\Models\Address;
use Persona\Models\Contact;
use Persona\Models\Document;
use Persona\Models\LegalDetail;
use Persona\Models\PhysicalAttribute;
use Persona\Models\Profile;
use Persona\Models\Relationship;
use Persona\Models\SocialAccount;
use Persona\Persona;

/**
 * Publishable API controller for the Persona ecosystem.
 *
 * Covers all 9 Persona tables. Reads run through the Persona models directly
 * (scoped by the authenticated user's morph pair), and every mutation is
 * performed through the fluent `Persona::for($user)` entry point — the same
 * scoped manager host applications use daily:
 *
 *     $contact = Persona::for($user)->addContact('email', 'ali@example.com');
 *
 * Copy this file to app/Http/Controllers and register your own routes
 * (the package intentionally ships no routes or middleware). Example:
 *
 *     use App\Http\Controllers\PersonaApiController;
 *
 *     // Profile
 *     Route::get('/persona/profile', [PersonaApiController::class, 'profile'])->middleware('auth');
 *     Route::put('/persona/profile', [PersonaApiController::class, 'updateProfile'])->middleware('auth');
 *
 *     // Contacts
 *     Route::get('/persona/contacts', [PersonaApiController::class, 'contacts'])->middleware('auth');
 *     Route::post('/persona/contacts', [PersonaApiController::class, 'addContact'])->middleware('auth');
 *     Route::delete('/persona/contacts/{contact}', [PersonaApiController::class, 'destroyContact'])->middleware('auth');
 *     Route::patch('/persona/contacts/{contact}/primary', [PersonaApiController::class, 'setPrimaryContact'])->middleware('auth');
 *     Route::get('/persona/contacts/{contact}/verification', [PersonaApiController::class, 'sendContactVerification'])->middleware('auth');
 *     Route::post('/persona/contacts/{contact}/verification', [PersonaApiController::class, 'verifyContact'])->middleware('auth');
 *
 *     // Addresses
 *     Route::get('/persona/addresses', [PersonaApiController::class, 'addresses'])->middleware('auth');
 *     Route::post('/persona/addresses', [PersonaApiController::class, 'storeAddress'])->middleware('auth');
 *     Route::delete('/persona/addresses/{address}', [PersonaApiController::class, 'destroyAddress'])->middleware('auth');
 *     Route::patch('/persona/addresses/{address}/primary', [PersonaApiController::class, 'setPrimaryAddress'])->middleware('auth');
 *
 *     // Social accounts
 *     Route::get('/persona/social-accounts', [PersonaApiController::class, 'socialAccounts'])->middleware('auth');
 *     Route::post('/persona/social-accounts', [PersonaApiController::class, 'storeSocialAccount'])->middleware('auth');
 *     Route::delete('/persona/social-accounts/{socialAccount}', [PersonaApiController::class, 'destroySocialAccount'])->middleware('auth');
 *     Route::patch('/persona/social-accounts/{socialAccount}/primary', [PersonaApiController::class, 'setPrimarySocialAccount'])->middleware('auth');
 *
 *     // Documents
 *     Route::get('/persona/documents', [PersonaApiController::class, 'documents'])->middleware('auth');
 *     Route::post('/persona/documents', [PersonaApiController::class, 'storeDocument'])->middleware('auth');
 *     Route::delete('/persona/documents/{document}', [PersonaApiController::class, 'destroyDocument'])->middleware('auth');
 *     Route::post('/persona/documents/{document}/files', [PersonaApiController::class, 'attachDocumentFile'])->middleware('auth');
 *
 *     // Physical attributes
 *     Route::get('/persona/physical-attributes', [PersonaApiController::class, 'physicalAttributes'])->middleware('auth');
 *     Route::put('/persona/physical-attributes', [PersonaApiController::class, 'updatePhysicalAttributes'])->middleware('auth');
 *
 *     // Legal details
 *     Route::get('/persona/legal-details', [PersonaApiController::class, 'legalDetails'])->middleware('auth');
 *     Route::put('/persona/legal-details', [PersonaApiController::class, 'updateLegalDetails'])->middleware('auth');
 *
 *     // Relationships
 *     Route::get('/persona/relationships', [PersonaApiController::class, 'relationships'])->middleware('auth');
 *     Route::post('/persona/relationships', [PersonaApiController::class, 'storeRelationship'])->middleware('auth');
 *     Route::delete('/persona/relationships/{relationship}', [PersonaApiController::class, 'destroyRelationship'])->middleware('auth');
 *
 * The personable is resolved from `$request->user()` here; hosts that need a
 * different owner (e.g. route-bound resources or tenant contexts) can replace
 * the `$this->personable($request)` call site with their own resolution.
 */
class PersonaApiController extends Controller
{
    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    /**
     * The polymorphic owner this request acts on.
     *
     * Resolved from `$request->user()`; hosts that need a different owner
     * (e.g. route-bound resources or tenant contexts) can override this one
     * call site instead of touching every controller method.
     */
    protected function personable(Request $request): Model
    {
        return $request->user()
            ?? throw new \Illuminate\Auth\AuthenticationException('Unauthenticated.');
    }

    /**
     * The morph pair that scopes all read queries.
     *
     * Queries run through the Persona models directly instead of relation
     * methods, so the host model does not need the HasPersona trait.
     *
     * @return array{personable_type: string, personable_id: string|int}
     */
    protected function scopeFor(Model $personable): array
    {
        return [
            'personable_type' => $personable->getMorphClass(),
            'personable_id' => $personable->getKey(),
        ];
    }

    /**
     * Run a mutation and translate the manager's domain exceptions into a 422.
     *
     * The managers throw InvalidArgumentException for domain rules (ownership
     * mismatches, duplicate values, invalid/self relationships, etc.).
     *
     * @template T
     * @param  callable(): T  $operation
     * @return T
     */
    protected function guarded(callable $operation): mixed
    {
        try {
            return $operation();
        } catch (\InvalidArgumentException $exception) {
            throw ValidationException::withMessages(['model' => $exception->getMessage()]);
        }
    }

    /**
     * Ensure a polymorphic record belongs to the authenticated personable.
     *
     * This covers both model route bindings and the Relationship model
     * which carries both personable_type/id AND related_personable_type/id.
     *
     * @throws ValidationException
     */
    protected function assertOwnedBy(Model $personable, Model $record): void
    {
        throw_if(
            $record->personable_type !== $personable->getMorphClass()
            || (string) $record->personable_id !== (string) $personable->getKey(),
            ValidationException::withMessages([
                'model' => sprintf(
                    'The %s does not belong to the given %s.',
                    class_basename($record),
                    class_basename($personable),
                ),
            ])
        );
    }

    // -------------------------------------------------------------------------
    // Profile
    // -------------------------------------------------------------------------

    public function profile(Request $request): JsonResponse
    {
        $profile = Profile::query()
            ->where($this->scopeFor($request->user()))
            ->first();

        abort_unless($profile, 404, 'No Persona profile exists for this account.');

        return ProfileResource::make($profile)->response();
    }

    public function updateProfile(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'first_name' => ['sometimes', 'string', 'max:255'],
            'middle_name' => ['sometimes', 'nullable', 'string', 'max:255'],
            'last_name' => ['sometimes', 'string', 'max:255'],
            'gender' => ['sometimes', 'nullable', Rule::in('male', 'female', 'non_binary', 'other', 'unspecified')],
            'birth_date' => ['sometimes', 'nullable', 'date'],
            'locale' => ['sometimes', 'nullable', 'string', 'max:10'],
            'timezone' => ['sometimes', 'nullable', 'string', 'max:64'],
        ]);

        $profile = $this->guarded(
            fn () => Persona::for($this->personable($request))->updateProfile($validated),
        );

        return ProfileResource::make($profile->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Contacts
    // -------------------------------------------------------------------------

    public function contacts(Request $request): JsonResponse
    {
        $contacts = Persona::for($this->personable($request))->getFootprint()['contacts'];

        return ContactResource::collection($contacts)->response();
    }

    public function addContact(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'type' => ['required', Rule::in('email', 'phone', 'handle')],
            'value' => ['required', 'string', 'max:255'],
            'is_primary' => ['sometimes', 'boolean'],
            'is_emergency' => ['sometimes', 'boolean'],
        ]);

        $contact = $this->guarded(
            fn () => Persona::for($this->personable($request))->addContact(
                $validated['type'],
                $validated['value'],
                $validated['is_primary'] ?? false,
                $validated['is_emergency'] ?? false,
            )
        );

        return ContactResource::make($contact)
            ->response()
            ->setStatusCode(201);
    }

    public function destroyContact(Request $request, Contact $contact): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $contact);

        if ($contact->is_primary) {
            throw ValidationException::withMessages([
                'contact' => 'The primary contact cannot be deleted. Assign a new primary first.',
            ]);
        }

        $this->guarded(fn () => Persona::for($personable)->deleteContact($contact));

        return response()->json(['deleted' => true]);
    }

    public function setPrimaryContact(Request $request, Contact $contact): JsonResponse
    {
        $this->guarded(fn () => Persona::for($this->personable($request))->makeContactPrimary($contact));

        return ContactResource::make($contact->fresh())->response();
    }

    public function sendContactVerification(Request $request, Contact $contact): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $contact);

        $this->guarded(fn () => Persona::for($personable)->sendContactVerification($contact));

        return response()->json(['sent' => true]);
    }

    public function verifyContact(Request $request, Contact $contact): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $contact);

        $validated = $request->validate([
            'otp' => ['required', 'string'],
        ]);

        $verified = $this->guarded(
            fn () => Persona::for($personable)->verifyContact($contact, $validated['otp'])
        );

        if (! $verified) {
            throw ValidationException::withMessages([
                'otp' => 'The verification code is invalid or has expired.',
            ]);
        }

        return ContactResource::make($contact->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Addresses
    // -------------------------------------------------------------------------

    public function addresses(Request $request): JsonResponse
    {
        $addresses = Address::query()
            ->where($this->scopeFor($request->user()))
            ->orderByDesc('is_primary')
            ->orderBy('created_at')
            ->get();

        return AddressResource::collection($addresses)->response();
    }

    public function storeAddress(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'type' => ['required', 'string', 'max:100'],
            'line_1' => ['required', 'string', 'max:255'],
            'line_2' => ['sometimes', 'nullable', 'string', 'max:255'],
            'city' => ['sometimes', 'nullable', 'string', 'max:255'],
            'state' => ['sometimes', 'nullable', 'string', 'max:255'],
            'country_code' => ['sometimes', 'nullable', 'string', 'max:2'],
            'zip_code' => ['sometimes', 'nullable', 'string', 'max:20'],
            'is_primary' => ['sometimes', 'boolean'],
        ]);

        $isPrimary = $validated['is_primary'] ?? false;
        $attributes = collect($validated)->except('type', 'line_1', 'is_primary')->filter()->all();

        $address = $this->guarded(
            fn () => Persona::for($this->personable($request))->addAddress(
                $validated['type'],
                $validated['line_1'],
                $attributes,
                $isPrimary,
            )
        );

        return AddressResource::make($address)
            ->response()
            ->setStatusCode(201);
    }

    public function destroyAddress(Request $request, Address $address): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $address);

        $this->guarded(fn () => Persona::for($personable)->deleteAddress($address));

        return response()->json(['deleted' => true]);
    }

    public function setPrimaryAddress(Request $request, Address $address): JsonResponse
    {
        $this->guarded(fn () => Persona::for($this->personable($request))->makeAddressPrimary($address));

        return AddressResource::make($address->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Social accounts
    // -------------------------------------------------------------------------

    public function socialAccounts(Request $request): JsonResponse
    {
        $accounts = SocialAccount::query()
            ->where($this->scopeFor($request->user()))
            ->orderByDesc('is_primary')
            ->orderBy('created_at')
            ->get();

        return SocialAccountResource::collection($accounts)->response();
    }

    public function storeSocialAccount(Request $request): JsonResponse
    {
        $socialPlatforms = config('persona.social_platforms', []);

        $validated = $request->validate([
            'platform' => ['required', 'string', Rule::in($socialPlatforms)],
            'username' => ['required', 'string', 'max:255'],
            'url' => ['sometimes', 'nullable', 'url', 'max:2048'],
            'is_primary' => ['sometimes', 'boolean'],
        ]);

        $account = $this->guarded(
            fn () => Persona::for($this->personable($request))->addSocialAccount(
                $validated['platform'],
                $validated['username'],
                $validated['url'] ?? null,
                $validated['is_primary'] ?? false,
            )
        );

        return SocialAccountResource::make($account)
            ->response()
            ->setStatusCode(201);
    }

    public function destroySocialAccount(Request $request, SocialAccount $socialAccount): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $socialAccount);

        $this->guarded(fn () => Persona::for($personable)->deleteSocialAccount($socialAccount));

        return response()->json(['deleted' => true]);
    }

    public function setPrimarySocialAccount(Request $request, SocialAccount $socialAccount): JsonResponse
    {
        $this->guarded(
            fn () => Persona::for($this->personable($request))->makeSocialAccountPrimary($socialAccount)
        );

        return SocialAccountResource::make($socialAccount->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Documents
    // -------------------------------------------------------------------------

    public function documents(Request $request): JsonResponse
    {
        $documents = Document::query()
            ->where($this->scopeFor($request->user()))
            ->whereNull('deleted_at')
            ->orderByDesc('created_at')
            ->get();

        return DocumentResource::collection($documents)->response();
    }

    public function storeDocument(Request $request): JsonResponse
    {
        $documentTypes = config('persona.document_types', []);

        $validated = $request->validate([
            'type' => ['required', 'string', Rule::in($documentTypes)],
            'number' => ['required', 'string', 'max:255'],
            'country_code' => ['sometimes', 'nullable', 'string', 'max:2'],
            'issued_at' => ['sometimes', 'nullable', 'date'],
            'expires_at' => ['sometimes', 'nullable', 'date', 'after:issued_at'],
        ]);

        $metadata = collect($validated)->except('type', 'number')->filter()->all();

        $document = $this->guarded(
            fn () => Persona::for($this->personable($request))->addDocument(
                $validated['type'],
                $validated['number'],
                $metadata,
            )
        );

        return DocumentResource::make($document)
            ->response()
            ->setStatusCode(201);
    }

    public function destroyDocument(Request $request, Document $document): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $document);

        $this->guarded(fn () => Persona::for($personable)->deleteDocument($document));

        return response()->json(['deleted' => true]);
    }

    public function attachDocumentFile(Request $request, Document $document): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $document);

        $validated = $request->validate([
            'file' => ['required', 'file', 'max:10240'],
            'disk' => ['sometimes', 'string', 'max:50'],
            'side' => ['sometimes', 'nullable', 'string', Rule::in('front', 'back')],
        ]);

        $storedPath = $request->file('file')->store(
            'persona/documents/' . $document->id,
            $validated['disk'] ?? config('persona.file_disk', 'local'),
        );

        abort_unless($storedPath, 500, 'Failed to store uploaded file.');

        $this->guarded(
            fn () => Persona::for($this->personable($request))->attachDocumentFile(
                $document,
                $storedPath,
                $validated['disk'] ?? config('persona.file_disk', 'local'),
                $validated['side'] ?? null,
            )
        );

        return DocumentResource::make($document->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Physical attributes
    // -------------------------------------------------------------------------

    public function physicalAttributes(Request $request): JsonResponse
    {
        $attributes = PhysicalAttribute::query()
            ->where($this->scopeFor($request->user()))
            ->first();

        abort_unless($attributes, 404, 'No physical attributes recorded for this account.');

        return PhysicalAttributeResource::make($attributes)->response();
    }

    public function updatePhysicalAttributes(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'height' => ['sometimes', 'nullable', 'numeric', 'min:0', 'max:300'],
            'weight' => ['sometimes', 'nullable', 'numeric', 'min:0', 'max:500'],
            'eye_color' => ['sometimes', 'nullable', 'string', 'max:50'],
            'hair_color' => ['sometimes', 'nullable', 'string', 'max:50'],
            'blood_type' => ['sometimes', 'nullable', Rule::in('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-')],
        ]);

        $attributes = $this->guarded(
            fn () => Persona::for($this->personable($request))->updatePhysicalAttributes($validated),
        );

        return PhysicalAttributeResource::make($attributes->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Legal details
    // -------------------------------------------------------------------------

    public function legalDetails(Request $request): JsonResponse
    {
        $details = LegalDetail::query()
            ->where($this->scopeFor($request->user()))
            ->first();

        abort_unless($details, 404, 'No legal details recorded for this account.');

        return LegalDetailResource::make($details)->response();
    }

    public function updateLegalDetails(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'nationality' => ['sometimes', 'nullable', 'string', 'max:3'],
            'marital_status' => ['sometimes', 'nullable', 'string', 'max:50'],
            'tax_id' => ['sometimes', 'nullable', 'string', 'max:255'],
        ]);

        $details = $this->guarded(
            fn () => Persona::for($this->personable($request))->updateLegalDetails($validated),
        );

        return LegalDetailResource::make($details->fresh())->response();
    }

    // -------------------------------------------------------------------------
    // Relationships
    // -------------------------------------------------------------------------

    public function relationships(Request $request): JsonResponse
    {
        $relationships = Relationship::query()
            ->where($this->scopeFor($request->user()))
            ->orderBy('created_at')
            ->get();

        return RelationshipResource::collection($relationships)->response();
    }

    public function storeRelationship(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'related_type' => ['required', 'string'],
            'related_id' => ['required', 'integer'],
            'type' => ['required', 'string', 'max:100'],
        ]);

        $morphMap = \Illuminate\Database\Eloquent\Relations\Relation::getMorphedModel($validated['related_type'])
            ?? $validated['related_type'];

        $related = app($morphMap)->query()->findOrFail($validated['related_id']);

        $relationship = $this->guarded(
            fn () => Persona::for($this->personable($request))->linkTo($related, $validated['type']),
        );

        return RelationshipResource::make($relationship)
            ->response()
            ->setStatusCode(201);
    }

    public function destroyRelationship(Request $request, Relationship $relationship): JsonResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $relationship);

        $targetModel = app($relationship->related_personable_type)
            ->query()
            ->findOrFail($relationship->related_personable_id);

        $this->guarded(fn () => Persona::for($personable)->unlinkFrom($targetModel, $relationship->type));

        return response()->json(['deleted' => true]);
    }
}