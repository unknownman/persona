<?php

namespace App\Http\Controllers;

use App\Http\Controllers\Controller;
use Illuminate\Auth\AuthenticationException;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;
use Illuminate\Validation\ValidationException;
use Inertia\Inertia;
use Inertia\Response;
use Persona\Contracts\SocialActivityResolverContract;
use Persona\Models\Document;
use Persona\Models\Relationship;
use Persona\Models\SocialAccount;
use Persona\Persona;

/**
 * Publishable Inertia controller for the Persona ecosystem.
 *
 * Renders the profile page with the persona footprint shaped into the
 * `PersonableBag` Vue interface, plus each social account's recent activity
 * resolved via SocialActivityResolverContract. Mutations use the fluent
 * `Persona::for($user)->...` entry point and return standard Inertia
 * form-submission redirects (this stub ships no routes itself).
 *
 * Example routes:
 *
 *     use App\Http\Controllers\PersonaController;
 *     use Illuminate\Support\Facades\Route;
 *
 *     Route::middleware(['auth', 'verified'])->group(function () {
 *         Route::get('/persona', [PersonaController::class, 'show']);
 *
 *         // Contacts
 *         Route::post('/persona/contacts', [PersonaController::class, 'storeContact']);
 *         Route::patch('/persona/contacts/{contact}/primary', [PersonaController::class, 'setPrimaryContact']);
 *         Route::delete('/persona/contacts/{contact}', [PersonaController::class, 'destroyContact']);
 *
 *         // Addresses
 *         Route::post('/persona/addresses', [PersonaController::class, 'storeAddress']);
 *
 *         // Social accounts
 *         Route::post('/persona/social-accounts', [PersonaController::class, 'storeSocialAccount']);
 *         Route::patch('/persona/social-accounts/{socialAccount}/primary', [PersonaController::class, 'setPrimarySocialAccount']);
 *         Route::delete('/persona/social-accounts/{socialAccount}', [PersonaController::class, 'destroySocialAccount']);
 *
 *         // Documents
 *         Route::post('/persona/documents', [PersonaController::class, 'storeDocument']);
 *         Route::post('/persona/documents/{document}/files', [PersonaController::class, 'attachDocumentFile']);
 *         Route::delete('/persona/documents/{document}', [PersonaController::class, 'destroyDocument']);
 *
 *         // Physical attributes
 *         Route::put('/persona/physical-attributes', [PersonaController::class, 'updatePhysicalAttributes']);
 *
 *         // Legal details
 *         Route::put('/persona/legal-details', [PersonaController::class, 'updateLegalDetails']);
 *
 *         // Relationships
 *         Route::post('/persona/relationships', [PersonaController::class, 'storeRelationship']);
 *         Route::delete('/persona/relationships/{relationship}', [PersonaController::class, 'destroyRelationship']);
 *     });
 *
 * The personable is resolved from `$request->user()` here; hosts that need a
 * different owner (e.g. route-bound resources or tenant contexts) can replace
 * the `$this->personable($request)` call site with their own resolution.
 */
class PersonaController extends Controller
{
    /**
     * The polymorphic owner this request acts on.
     *
     * @throws AuthenticationException
     */
    protected function personable(Request $request): Model
    {
        return $request->user()
            ?? throw new AuthenticationException('Unauthenticated.');
    }

    /**
     * Run a mutation and translate domain exceptions into session errors.
     *
     * The managers throw InvalidArgumentException for domain rules (ownership
     * mismatches, duplicate values, invalid/self relationships, etc.).
     *
     * @template T
     * @param  callable(): T  $operation
     * @return T
     */
    protected function guarded(callable $operation): mixed
    {
        try {
            return $operation();
        } catch (\InvalidArgumentException $exception) {
            throw ValidationException::withMessages(['model' => $exception->getMessage()]);
        }
    }

    /**
     * Ensure a polymorphic record belongs to the authenticated personable.
     */
    protected function assertOwnedBy(Model $personable, Model $record): void
    {
        throw_if(
            $record->personable_type !== $personable->getMorphClass()
            || (string) $record->personable_id !== (string) $personable->getKey(),
            ValidationException::withMessages([
                'model' => sprintf(
                    'The %s does not belong to the given %s.',
                    class_basename($record),
                    class_basename($personable),
                ),
            ])
        );
    }

    // -------------------------------------------------------------------------
    // Profile
    // -------------------------------------------------------------------------

    /**
     * Render the Persona page as a nested PersonableBag.
     *
     * The page component receives a single `personable` object shaped like the
     * `PersonableBag` interface, plus the resolved `relationships`,
     * `socialActivities` (keyed by account id), and the `personaScope` morph
     * pair the bag belongs to. Eloquent models are returned directly: Inertia
     * serializes them to plain objects, and Persona's internal lookup hashes
     * are `$hidden`, so nothing sensitive leaves the server.
     */
    public function show(Request $request): Response
    {
        $personable = $this->personable($request);

        $footprint = Persona::for($personable)->getFootprint();

        $resolver = app(SocialActivityResolverContract::class);

        $socialActivities = [];

        foreach ($footprint['socialAccounts'] as $account) {
            $socialActivities[$account->getKey()] = $resolver->getRecentActivity($account);
        }

        return Inertia::render('Profile', [
            'personable' => [
                'profile'            => $footprint['profile'],
                'contacts'           => $footprint['contacts'],
                'addresses'          => $footprint['addresses'],
                'documents'          => $footprint['documents'],
                'social_accounts'    => $footprint['socialAccounts'],
                'physical_attribute' => $footprint['physicalAttribute'],
                'legal_detail'       => $footprint['legalDetail'],
            ],
            'relationships' => $footprint['relationships'],
            'socialActivities' => $socialActivities,
            'personaScope' => [
                'personable_type' => $personable->getMorphClass(),
                'personable_id'   => $personable->getKey(),
            ],
        ]);
    }

    // -------------------------------------------------------------------------
    // Contacts
    // -------------------------------------------------------------------------

    public function storeContact(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'type' => ['required', 'string'],
            'value' => ['required', 'string', 'max:255'],
            'is_primary' => ['sometimes', 'boolean'],
            'is_emergency' => ['sometimes', 'boolean'],
        ]);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->addContact(
                type: $validated['type'],
                value: $validated['value'],
                isPrimary: $validated['is_primary'] ?? false,
                isEmergency: $validated['is_emergency'] ?? false,
            )
        );

        return back()->with('success', 'Contact added.');
    }

    public function setPrimaryContact(Request $request, string $contact): RedirectResponse
    {
        $persona = Persona::for($this->personable($request));

        $contactModel = $persona->getFootprint()['contacts']->firstWhere('id', $contact)
            ?? abort(404, 'The contact does not belong to this account.');

        $this->guarded(fn () => $persona->makeContactPrimary($contactModel));

        return back()->with('success', 'Primary contact updated.');
    }

    public function destroyContact(Request $request, string $contact): RedirectResponse
    {
        $persona = Persona::for($this->personable($request));

        $contactModel = $persona->getFootprint()['contacts']->firstWhere('id', $contact)
            ?? abort(404, 'The contact does not belong to this account.');

        $this->guarded(fn () => $persona->deleteContact($contactModel));

        return back()->with('success', 'Contact removed.');
    }

    // -------------------------------------------------------------------------
    // Addresses
    // -------------------------------------------------------------------------

    public function storeAddress(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'type' => ['required', 'string', 'max:100'],
            'line_1' => ['required', 'string', 'max:255'],
            'line_2' => ['sometimes', 'nullable', 'string', 'max:255'],
            'city' => ['sometimes', 'nullable', 'string', 'max:255'],
            'state' => ['sometimes', 'nullable', 'string', 'max:255'],
            'country_code' => ['sometimes', 'nullable', 'string', 'max:2'],
            'zip_code' => ['sometimes', 'nullable', 'string', 'max:20'],
            'is_primary' => ['sometimes', 'boolean'],
        ]);

        $isPrimary = $validated['is_primary'] ?? false;
        unset($validated['is_primary']);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->addAddress(
                type: $validated['type'],
                line1: $validated['line_1'],
                attributes: collect($validated)->only([
                    'line_2', 'city', 'state', 'country_code', 'zip_code',
                ])->filter()->all(),
                isPrimary: $isPrimary,
            )
        );

        return back()->with('success', 'Address added.');
    }

    // -------------------------------------------------------------------------
    // Social accounts
    // -------------------------------------------------------------------------

    public function storeSocialAccount(Request $request): RedirectResponse
    {
        $socialPlatforms = config('persona.social_platforms', []);

        $validated = $request->validate([
            'platform' => ['required', 'string', Rule::in($socialPlatforms)],
            'username' => ['required', 'string', 'max:255'],
            'url' => ['sometimes', 'nullable', 'url', 'max:2048'],
            'is_primary' => ['sometimes', 'boolean'],
        ]);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->addSocialAccount(
                $validated['platform'],
                $validated['username'],
                $validated['url'] ?? null,
                $validated['is_primary'] ?? false,
            )
        );

        return back()->with('success', 'Social account added.');
    }

    public function setPrimarySocialAccount(Request $request, SocialAccount $socialAccount): RedirectResponse
    {
        $this->assertOwnedBy($this->personable($request), $socialAccount);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->makeSocialAccountPrimary($socialAccount)
        );

        return back()->with('success', 'Primary social account updated.');
    }

    public function destroySocialAccount(Request $request, SocialAccount $socialAccount): RedirectResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $socialAccount);

        $this->guarded(fn () => Persona::for($personable)->deleteSocialAccount($socialAccount));

        return back()->with('success', 'Social account removed.');
    }

    // -------------------------------------------------------------------------
    // Documents
    // -------------------------------------------------------------------------

    public function storeDocument(Request $request): RedirectResponse
    {
        $documentTypes = config('persona.document_types', []);

        $validated = $request->validate([
            'type' => ['required', 'string', Rule::in($documentTypes)],
            'number' => ['required', 'string', 'max:255'],
            'country_code' => ['sometimes', 'nullable', 'string', 'max:2'],
            'issued_at' => ['sometimes', 'nullable', 'date'],
            'expires_at' => ['sometimes', 'nullable', 'date', 'after:issued_at'],
        ]);

        $metadata = collect($validated)->except('type', 'number')->filter()->all();

        $this->guarded(
            fn () => Persona::for($this->personable($request))->addDocument(
                $validated['type'],
                $validated['number'],
                $metadata,
            )
        );

        return back()->with('success', 'Document added.');
    }

    public function attachDocumentFile(Request $request, Document $document): RedirectResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $document);

        $validated = $request->validate([
            'file' => ['required', 'file', 'max:10240'],
            'disk' => ['sometimes', 'string', 'max:50'],
            'side' => ['sometimes', 'nullable', 'string', Rule::in('front', 'back')],
        ]);

        $storedPath = $request->file('file')->store(
            'persona/documents/' . $document->id,
            $validated['disk'] ?? config('persona.storage.disk', 'local'),
        );

        abort_unless($storedPath, 500, 'Failed to store uploaded file.');

        $this->guarded(
            fn () => Persona::for($personable)->attachDocumentFile(
                $document,
                $storedPath,
                $validated['disk'] ?? config('persona.storage.disk', 'local'),
                $validated['side'] ?? null,
            )
        );

        return back()->with('success', 'Document file attached.');
    }

    public function destroyDocument(Request $request, Document $document): RedirectResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $document);

        $this->guarded(fn () => Persona::for($personable)->deleteDocument($document));

        return back()->with('success', 'Document removed.');
    }

    // -------------------------------------------------------------------------
    // Physical attributes
    // -------------------------------------------------------------------------

    public function updatePhysicalAttributes(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'height' => ['sometimes', 'nullable', 'numeric', 'min:0', 'max:300'],
            'weight' => ['sometimes', 'nullable', 'numeric', 'min:0', 'max:500'],
            'eye_color' => ['sometimes', 'nullable', 'string', 'max:50'],
            'hair_color' => ['sometimes', 'nullable', 'string', 'max:50'],
            'blood_type' => ['sometimes', 'nullable', Rule::in('A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-')],
        ]);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->updatePhysicalAttributes($validated)
        );

        return back()->with('success', 'Physical attributes updated.');
    }

    // -------------------------------------------------------------------------
    // Legal details
    // -------------------------------------------------------------------------

    public function updateLegalDetails(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'nationality' => ['sometimes', 'nullable', 'string', 'max:3'],
            'marital_status' => ['sometimes', 'nullable', 'string', 'max:50'],
            'tax_id' => ['sometimes', 'nullable', 'string', 'max:255'],
        ]);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->updateLegalDetails($validated)
        );

        return back()->with('success', 'Legal details updated.');
    }

    // -------------------------------------------------------------------------
    // Relationships
    // -------------------------------------------------------------------------

    public function storeRelationship(Request $request): RedirectResponse
    {
        $validated = $request->validate([
            'related_type' => ['required', 'string'],
            'related_id' => ['required', 'integer'],
            'type' => ['required', 'string', 'max:100'],
        ]);

        $morphMap = \Illuminate\Database\Eloquent\Relations\Relation::getMorphedModel($validated['related_type'])
            ?? $validated['related_type'];

        $related = app($morphMap)->query()->findOrFail($validated['related_id']);

        $this->guarded(
            fn () => Persona::for($this->personable($request))->linkTo($related, $validated['type'])
        );

        return back()->with('success', 'Relationship created.');
    }

    public function destroyRelationship(Request $request, Relationship $relationship): RedirectResponse
    {
        $personable = $this->personable($request);

        $this->assertOwnedBy($personable, $relationship);

        $targetModel = app($relationship->related_personable_type)
            ->query()
            ->findOrFail($relationship->related_personable_id);

        $this->guarded(fn () => Persona::for($personable)->unlinkFrom($targetModel, $relationship->type));

        return back()->with('success', 'Relationship removed.');
    }
}